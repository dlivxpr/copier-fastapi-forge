# 开发环境变量（对应 deploy/compose.yaml）
# 使用：cp deploy/.env.example deploy/.env，然后从项目根执行
#   docker compose --env-file deploy/.env -f deploy/compose.yaml up --build
# deploy/.env 不提交 Git、不进入镜像；修改后重启 compose 生效。

# Compose 基础设施
# 宿主机 API 端口（绑定 127.0.0.1，仅本机访问）
BACKEND_PORT=[[ backend_port ]]
[% if database == "postgresql" %]# 宿主机 PostgreSQL 端口（绑定 127.0.0.1）
POSTGRES_PUBLISHED_PORT=5432
[% endif %][% if enable_redis or background_tasks == "taskiq" %]# 宿主机 Redis 端口（绑定 127.0.0.1）
REDIS_PUBLISHED_PORT=6379
[% endif %]
# 应用运行配置（经 env_file 注入 app[% if background_tasks == "taskiq" %]/worker/scheduler[% endif %] 容器）
PROJECT_NAME=[[ project_name ]]
ENVIRONMENT=local
DEBUG=true
TIMEZONE=[[ timezone ]]
MAX_UPLOAD_SIZE_MB=50
API_KEY=[[ deployment_api_key ]]
API_KEY_HEADER=X-API-Key
[% if database == "postgresql" %]
# PostgreSQL（compose 内部 service 名为 db）
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=[[ project_slug ]]
# 连接池按每个 Gunicorn worker 计数（固定 --workers 2）
DB_POOL_SIZE=[[ db_pool_size ]]
DB_MAX_OVERFLOW=[[ db_max_overflow ]]
DB_POOL_TIMEOUT=[[ db_pool_timeout ]]
DB_ECHO=false
[% endif %][% if enable_redis or background_tasks == "taskiq" %]
# Redis（compose 内部 service 名为 redis）
# 留空 = 无密码；设值后 redis 服务与客户端自动使用同一密码
REDIS_PASSWORD=
[% endif %][% if enable_redis %]REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
[% endif %][% if background_tasks == "taskiq" %]
# Taskiq（${REDIS_PASSWORD} 引用本文件变量；密码须 URL-safe，建议 openssl rand -hex 16）
TASKIQ_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
TASKIQ_RESULT_BACKEND_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
TASKIQ_STREAM_NAME=[[ project_slug ]]:taskiq
TASKIQ_STREAM_MAXLEN=100000
TASKIQ_STREAM_IDLE_TIMEOUT_MS=3600000
[% endif %][% if enable_rate_limiting %]
# Rate limiting
RATE_LIMIT_REQUESTS=[[ rate_limit_requests ]]
RATE_LIMIT_PERIOD=[[ rate_limit_period ]]
RATE_LIMIT_STORAGE=[[ rate_limit_storage ]]
[% endif %][% if ai_framework == "pydantic_ai" %]
# Pydantic AI（开发占位值，接入真实模型时替换）
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=model-key-CHANGEME
LLM_MODEL=model-name-CHANGEME
[% endif %][% if ai_framework == "pydantic_ai" and enable_logfire %]
# Logfire（LOGFIRE_TOKEN 留空则不发送遥测）
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=[[ project_slug ]]
LOGFIRE_ENVIRONMENT=development
[% endif %]
