[% set needs_redis = enable_redis or background_tasks == "taskiq" or (enable_rate_limiting and rate_limit_storage == "redis") -%]
name: [[ project_slug ]]_prod

# 生产必填环境变量校验：任一变量缺失或为空时，docker compose 解析即失败。
x-required-env:
  API_KEY: "${API_KEY:?必须在 deploy/.env.prod 设置非空 API_KEY}"
[% if database == "postgresql" %]  POSTGRES_PASSWORD: "${POSTGRES_PASSWORD:?必须在 deploy/.env.prod 设置非空 POSTGRES_PASSWORD}"
[% endif %][% if needs_redis %]  REDIS_PASSWORD: "${REDIS_PASSWORD:?必须在 deploy/.env.prod 设置非空 REDIS_PASSWORD}"
[% endif %][% if ai_framework == "pydantic_ai" %]  LLM_BASE_URL: "${LLM_BASE_URL:?必须在 deploy/.env.prod 设置非空 LLM_BASE_URL}"
  LLM_API_KEY: "${LLM_API_KEY:?必须在 deploy/.env.prod 设置非空 LLM_API_KEY}"
  LLM_MODEL: "${LLM_MODEL:?必须在 deploy/.env.prod 设置非空 LLM_MODEL}"
[% endif %]
# 所有服务统一使用 json-file 日志驱动并限制单容器日志上限，避免长跑后占满宿主磁盘。
x-logging: &default-logging
  driver: json-file
  options:
    max-size: "100M"

services:
  app:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
    image: [[ project_slug ]]_backend:prod
    env_file:
      - .env.prod
    ports:
      - "${BACKEND_BIND_HOST:-127.0.0.1}:${BACKEND_PORT:-[[ backend_port ]]}:[[ backend_port ]]"
[% if database == "postgresql" or needs_redis %]    depends_on:
[% if database == "postgresql" %]      db:
        condition: service_healthy
[% endif %][% if needs_redis %]      redis:
        condition: service_healthy
[% endif %][% endif %]    networks:
      - backend
    logging: *default-logging
    restart: always
[% if database == "postgresql" %]
  db:
    image: postgres:16-alpine
    environment:
      POSTGRES_DB: "${POSTGRES_DB:-[[ project_slug ]]}"
      POSTGRES_USER: "${POSTGRES_USER:-postgres}"
      POSTGRES_PASSWORD: "${POSTGRES_PASSWORD:?必须在 deploy/.env.prod 设置非空 POSTGRES_PASSWORD}"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - backend
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-[[ project_slug ]]}" ]
      interval: 10s
      timeout: 5s
      retries: 5
    logging: *default-logging
    restart: always
[% endif %][% if needs_redis %]
  redis:
    image: redis:7-alpine
    command:
      - sh
      - -c
      - >-
        if [ -n "$$REDIS_PASSWORD" ]; then
          exec redis-server --appendonly yes --requirepass "$$REDIS_PASSWORD";
        else
          exec redis-server --appendonly yes;
        fi
    environment:
      REDIS_PASSWORD: "${REDIS_PASSWORD:?必须在 deploy/.env.prod 设置非空 REDIS_PASSWORD}"
    volumes:
      - redis_data:/data
    networks:
      - backend
    healthcheck:
      test: ["CMD-SHELL", "if [ -n \"$$REDIS_PASSWORD\" ]; then redis-cli -a \"$$REDIS_PASSWORD\" ping; else redis-cli ping; fi"]
      interval: 10s
      timeout: 5s
      retries: 5
    logging: *default-logging
    restart: always
[% endif %][% if background_tasks == "taskiq" %]
  worker:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
    image: [[ project_slug ]]_backend:prod
    command: ["python", "-m", "cli.commands", "taskiq", "worker"]
    env_file:
      - .env.prod
    depends_on:
      redis:
        condition: service_healthy
[% if database == "postgresql" %]      db:
        condition: service_healthy
[% endif %]    networks:
      - backend
    logging: *default-logging
    restart: always

  scheduler:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
    image: [[ project_slug ]]_backend:prod
    command: ["python", "-m", "cli.commands", "taskiq", "scheduler"]
    env_file:
      - .env.prod
    depends_on:
      redis:
        condition: service_healthy
[% if database == "postgresql" %]      db:
        condition: service_healthy
[% endif %]    networks:
      - backend
    logging: *default-logging
    restart: always
[% endif %]
networks:
  backend:
    driver: bridge
[% if database == "postgresql" or needs_redis %]
volumes:
[% if database == "postgresql" %]  postgres_data:
[% endif %][% if needs_redis %]  redis_data:
[% endif %][% endif %]
