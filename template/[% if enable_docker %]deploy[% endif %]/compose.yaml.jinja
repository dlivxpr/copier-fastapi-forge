[% set needs_redis = enable_redis or background_tasks == "taskiq" or (enable_rate_limiting and rate_limit_storage == "redis") -%]
name: [[ project_slug ]]_dev

services:
  app:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
    image: [[ project_slug ]]_backend:dev
    command: ["gunicorn", "app.main:app", "--config", "/app/deploy/gunicorn.dev.conf.py", "--worker-class", "uvicorn_worker.UvicornWorker", "--workers", "2", "--bind", "0.0.0.0:[[ backend_port ]]", "--reload"]
    env_file:
      - .env
    ports:
      - "127.0.0.1:${BACKEND_PORT:-[[ backend_port ]]}:[[ backend_port ]]"
    volumes:
      - ../app:/app/app:ro
      - ../cli:/app/cli:ro
[% if database == "postgresql" or needs_redis %]    depends_on:
[% if database == "postgresql" %]      db:
        condition: service_healthy
[% endif %][% if needs_redis %]      redis:
        condition: service_healthy
[% endif %][% endif %]    networks:
      - backend
    restart: unless-stopped
[% if database == "postgresql" %]
  db:
    image: postgres:16-alpine
    environment:
      POSTGRES_DB: "${POSTGRES_DB:-[[ project_slug ]]}"
      POSTGRES_USER: "${POSTGRES_USER:-postgres}"
      POSTGRES_PASSWORD: "${POSTGRES_PASSWORD:-postgres}"
    ports:
      - "127.0.0.1:${POSTGRES_PUBLISHED_PORT:-5432}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - backend
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-[[ project_slug ]]}" ]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped
[% endif %][% if needs_redis %]
  redis:
    image: redis:7-alpine
    command:
      - sh
      - -c
      - >-
        if [ -n "$$REDIS_PASSWORD" ]; then
          exec redis-server --appendonly yes --requirepass "$$REDIS_PASSWORD";
        else
          exec redis-server --appendonly yes;
        fi
    environment:
      REDIS_PASSWORD: "${REDIS_PASSWORD:-}"
    ports:
      - "127.0.0.1:${REDIS_PUBLISHED_PORT:-6379}:6379"
    volumes:
      - redis_data:/data
    networks:
      - backend
    healthcheck:
      test: ["CMD-SHELL", "if [ -n \"$$REDIS_PASSWORD\" ]; then redis-cli -a \"$$REDIS_PASSWORD\" ping; else redis-cli ping; fi"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped
[% endif %][% if background_tasks == "taskiq" %]
  worker:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
    image: [[ project_slug ]]_backend:dev
    command: ["python", "-m", "cli.commands", "taskiq", "worker", "--reload"]
    env_file:
      - .env
    volumes:
      - ../app:/app/app:ro
      - ../cli:/app/cli:ro
    depends_on:
      redis:
        condition: service_healthy
[% if database == "postgresql" %]      db:
        condition: service_healthy
[% endif %]    networks:
      - backend
    restart: unless-stopped

  scheduler:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
    image: [[ project_slug ]]_backend:dev
    command: ["python", "-m", "cli.commands", "taskiq", "scheduler"]
    env_file:
      - .env
    volumes:
      - ../app:/app/app:ro
      - ../cli:/app/cli:ro
    depends_on:
      redis:
        condition: service_healthy
[% if database == "postgresql" %]      db:
        condition: service_healthy
[% endif %]    networks:
      - backend
    restart: unless-stopped
[% endif %]
networks:
  backend:
    driver: bridge
[% if database == "postgresql" or needs_redis %]
volumes:
[% if database == "postgresql" %]  postgres_data:
[% endif %][% if needs_redis %]  redis_data:
[% endif %][% endif %]
