# 生产环境变量（对应 deploy/compose.prod.yaml）
# 使用：cp deploy/.env.prod.example deploy/.env.prod，填入真实值，然后从项目根执行
#   docker compose --env-file deploy/.env.prod -f deploy/compose.prod.yaml up -d --build
# deploy/.env.prod 不提交 Git、不进入镜像。
# 生产必填项见下方已启用能力的配置段；缺失或为空时 Compose 拒绝启动。

# Compose 基础设施
# API 宿主绑定地址（默认 127.0.0.1；远程压测可显式改为 0.0.0.0）
BACKEND_BIND_HOST=127.0.0.1
# 宿主机 API 端口
BACKEND_PORT=[[ backend_port ]]

# 应用运行配置（经 env_file 注入 app[% if background_tasks == "taskiq" %]/worker/scheduler[% endif %] 容器）
PROJECT_NAME=[[ project_name ]]
ENVIRONMENT=production
DEBUG=false
TIMEZONE=[[ timezone ]]
MAX_UPLOAD_SIZE_MB=50
# 必填：生成真实密钥，如 openssl rand -hex 32
API_KEY=
API_KEY_HEADER=X-API-Key
[% if database == "postgresql" %]
# PostgreSQL（compose 内部 service 名为 db，不发布宿主端口）
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# 必填：非空密码
POSTGRES_PASSWORD=
POSTGRES_DB=[[ project_slug ]]
# 连接池按每个 Gunicorn worker 计数（固定 --workers 2）
DB_POOL_SIZE=[[ db_pool_size ]]
DB_MAX_OVERFLOW=[[ db_max_overflow ]]
DB_POOL_TIMEOUT=[[ db_pool_timeout ]]
DB_ECHO=false
[% endif %][% if enable_redis or background_tasks == "taskiq" %]
# Redis（compose 内部 service 名为 redis，不发布宿主端口）
# 必填：非空密码，须 URL-safe，建议 openssl rand -hex 32
REDIS_PASSWORD=
[% endif %][% if enable_redis %]REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
[% endif %][% if background_tasks == "taskiq" %]
# Taskiq（${REDIS_PASSWORD} 引用本文件变量；密码若含特殊字符必须 URL 编码）
TASKIQ_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
TASKIQ_RESULT_BACKEND_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
TASKIQ_STREAM_NAME=[[ project_slug ]]:taskiq
TASKIQ_STREAM_MAXLEN=100000
TASKIQ_STREAM_IDLE_TIMEOUT_MS=3600000
[% endif %][% if enable_rate_limiting %]
# Rate limiting
RATE_LIMIT_REQUESTS=[[ rate_limit_requests ]]
RATE_LIMIT_PERIOD=[[ rate_limit_period ]]
RATE_LIMIT_STORAGE=[[ rate_limit_storage ]]
[% endif %][% if ai_framework == "pydantic_ai" %]
# Pydantic AI（必填：生产必须填写真实 endpoint/key/model，无占位兜底）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
[% endif %][% if ai_framework == "pydantic_ai" and enable_logfire %]
# Logfire（可选；LOGFIRE_TOKEN 留空则不发送遥测）
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=[[ project_slug ]]
LOGFIRE_ENVIRONMENT=production
[% endif %]
