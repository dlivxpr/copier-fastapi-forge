[project]
name = "[[ project_slug ]]"
version = "0.1.0"
description = "[[ project_description ]]"
readme = "README.md"
requires-python = ">=[[ python_version ]]"
authors = [
    { name = "[[ author_name ]]", email = "[[ author_email ]]" },
]
dependencies = [
    "click>=8.4.2",
    "fastapi[standard]>=0.140.0",
    "pydantic-settings>=2.14.2",
    "tabulate>=0.10.0",
    "uvicorn[standard]>=0.51.0",
[% if database == "postgresql" %]
    "alembic>=1.18.5",
    "asyncpg>=0.31.0",
    "greenlet>=3.5.4",
    "psycopg2-binary>=2.9.12",
[% if orm_type == "sqlalchemy" %]
    "sqlalchemy[asyncio]>=2.0.51",
[% else %]
    "sqlmodel>=0.0.39",
[% endif %]
[% endif %]
[% if enable_redis %]
    "redis>=8.0.1",
[% endif %]
[% if background_tasks == "taskiq" %]
    "taskiq>=0.12.4",
    "taskiq-redis>=1.2.3",
[% endif %]
[% if enable_caching %]
    "fastapi-cache2>=0.2.2",
[% endif %]
[% if enable_rate_limiting %]
    "slowapi>=0.1.10",
[% endif %]
[% if ai_framework == "pydantic_ai" %]
    "pydantic-ai-slim[openai]>=2.18.0",
[% endif %]
[% if ai_framework == "pydantic_ai" and enable_logfire %]
    "logfire>=4.39.0",
[% endif %]
]

[project.scripts]
[[ project_slug ]] = "cli.commands:cli"

[build-system]
requires = ["hatchling>=1.31.0"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["app", "cli"]

[dependency-groups]
dev = [
    "anyio>=4.14.2",
    "httpx>=0.28.1",
    "pytest>=9.1.1",
    "pytest-cov>=7.1.0",
    "ruff>=0.16.0",
    "ty>=0.0.63",
]

[tool.ruff]
line-length = 100
target-version = "py[[ python_version | replace('.', '') ]]"

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM", "RUF"]

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.ty.src]
include = ["app", "cli", "tests"]

[tool.coverage.run]
source = ["app", "cli"]
[% if database == "postgresql" %]
concurrency = ["greenlet", "thread"]
[% endif %]

[tool.coverage.report]
fail_under = 100
show_missing = true
